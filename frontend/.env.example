# ==============================================================================
# Rumah Jamur Frontend Environment Configuration Template
# Copy this file to .env and configure for your environment.
# DO NOT COMMIT SECRETS TO GIT.
# ==============================================================================

# API Base URL of the FastAPI backend.
# In PRODUCTION (when served behind Nginx on sirkulalestari.com), leave EMPTY
# so the browser uses same-origin relative URLs (/api).
# For local dev: http://localhost:8000
VITE_API_URL=

# WebSocket Base URL of the FastAPI backend.
# In PRODUCTION, leave EMPTY so it auto-resolves to wss://sirkulalestari.com
# For local dev: ws://localhost:8000
VITE_WS_URL=

# Optional: Default Control API Key if you want pre-authorized manual control
# in private deployments (Leave empty in public dashboard builds)
VITE_CONTROL_API_KEY=
