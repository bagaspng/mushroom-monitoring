# ==============================================================================
# Rumah Jamur Backend Configuration Environment Template
# Copy this file to .env and configure for your environment (development/production).
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GIT!
# ==============================================================================

# Application Environment: 'development' or 'production'
APP_ENV=development

# Allowed CORS Origins (comma-separated).
# In production, set to: https://sirkulalestari.com,https://www.sirkulalestari.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Key for manual pump control (POST /api/control)
# Generate a strong 32+ character random string in production (e.g., openssl rand -hex 24)
CONTROL_API_KEY=

# MQTT Broker Configuration
# For local dev: localhost / 1883
# For production: 127.0.0.1 (internal VPS) or domain with TLS on 8883
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# MQTT Authentication (Required in Production)
MQTT_USERNAME=backend_service
MQTT_PASSWORD=

# MQTT TLS Options (Set to true if connecting to external broker on port 8883)
MQTT_TLS=false
MQTT_TLS_CA_CERT=
MQTT_TLS_INSECURE=false

# SQLite Database Location
DATABASE_URL=./jamur_dashboard.db
